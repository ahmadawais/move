<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No entitlements. The App Sandbox is off because it blocks the Accessibility API
	     (mach-lookup com.apple.axserver). Networking is blocked instead by a kernel sandbox
	     profile Move applies to itself at launch: Sources/MoveKit/NoNetwork.swift. -->
</dict>
</plist>
